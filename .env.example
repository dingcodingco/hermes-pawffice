# 이 파일을 .env 로 복사한 뒤 값을 채워요. .env 는 깃허브에 올리지 마세요.
# 키는 직접 입력해요. ~/.hermes/.env 의 API_SERVER_KEY 와 같은 값이에요.

# 기본(default) 프로필 봇에게 말 걸기
HERMES_API_KEY=

# 다른 프로필 봇에게도 말 걸려면 프로필마다 한 줄씩 (프로필 이름은 대문자, - 는 _ 로)
# 값은 ~/.hermes/profiles/<프로필>/.env 의 API_SERVER_KEY
# HERMES_API_KEY_SALES=

# 헤르메스 API 서버 주소 (기본값이면 비워 두세요)
# HERMES_API_URL=http://127.0.0.1:8642
# 프로필이 따로 다른 포트에서 돌면
# HERMES_API_URL_SALES=http://127.0.0.1:8643
